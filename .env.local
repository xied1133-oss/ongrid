# 本地开发环境变量（source 后 go run ./cmd/ongrid）
# 数据库默认连 127.0.0.1:3306（compose 起的 mysql 容器），无需配置

# 管理员 bootstrap（首次启动自动建号）
ONGRID_ADMIN_EMAIL=admin@localhost.dev
ONGRID_ADMIN_PASSWORD=admin12345

# 本地 frontier broker（docker run 起的 ongrid-frontier 容器）
ONGRID_FRONTIER_ADDR=127.0.0.1:40011

# Edge 数据面地址：填本机局域网 IP（ifconfig en0），测试机要能访问到
ONGRID_PUBLIC_URL=http://10.50.209.201:8090

# 依赖容器（compose --no-deps 起的三个）
ONGRID_QDRANT_URL=http://127.0.0.1:6333
ONGRID_PROM_ENABLED=true
ONGRID_PROM_URL=http://127.0.0.1:9090/prometheus
ONGRID_PROM_QUERY_URL=http://127.0.0.1:9090/prometheus
ONGRID_PROM_REMOTE_WRITE_URL=http://127.0.0.1:9090/prometheus/api/v1/write

# 本地没起 loki/tempo，关掉日志与链路查询（置空即禁用）
ONGRID_LOG_QUERY_URL=
ONGRID_TRACE_QUERY_URL=

# JWT 签名密钥（本地开发随机生成）
ONGRID_JWT_SECRET=dm2k9piqdbdDcjkAllK0Z4md2SW2jxtJzuIXsAJJab4=
